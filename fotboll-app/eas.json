      "developmentClient": true,
      "distribution": "internal",
      "channel": "development"
    },
    "dev-staging": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "staging",
      "env": { "APP_ENV": "staging" }
    },
    "staging": {
      "distribution": "internal",
      "channel": "staging",
      "env": {
        "APP_ENV": "staging"
      }
    },
    "production": {
      "channel": "production",
      "distribution": "store"
    },
    "appstore-staging": {
      "channel": "staging",
      "distribution": "store",
      "env": { "APP_ENV": "staging" }
    }
  },
